# Copy to .env.local. Every variable is optional; each one unlocks a feature.

# Signed verification: QR codes carry a tamper-proof link, no database needed.
# Generate with: openssl rand -hex 32   (keep it secret, and never change it once
# certificates are issued, or their links stop verifying)
CERTIFY_SECRET=

# Certificate registry: shorter QR links plus the admin dashboard. Any MongoDB works.
# (Legacy deployments can keep using DB_PASSWORD instead.)
MONGODB_URI=

# Public URL used in verification links. Defaults to the address the site is opened on.
HOSTED_URL=

# Instance admin dashboard at /dashboard (lists registry certificates).
ADMIN_ORG_ID=
ADMIN_PASSWORD=

# Allow SMTP servers on private networks (e.g. a local relay). Leave unset on public instances.
ALLOW_PRIVATE_SMTP=
